# MeteoRisco — Variáveis de Ambiente
# Copie este arquivo para .env e preencha os valores

# ─── LLM Provider (escolha UM) ────────────────────────────────────────────────
# Pendente aprovação do grupo (P06 no Master Plan)
# LLM_PROVIDER=gemini          # ou: openai | anthropic
# GEMINI_API_KEY=sua_chave_aqui
# OPENAI_API_KEY=sua_chave_aqui
# ANTHROPIC_API_KEY=sua_chave_aqui

# LLM Model name (depende do provider escolhido)
# LLM_MODEL=gemini-2.0-flash   # ou: gpt-4o-mini | claude-3-haiku-20240307

# ─── Open-Meteo ───────────────────────────────────────────────────────────────
# Sem API key — acesso público gratuito
OPEN_METEO_BASE_URL=https://api.open-meteo.com/v1/forecast
OPEN_METEO_TIMEOUT_SECONDS=30

# ─── Pipeline ─────────────────────────────────────────────────────────────────
# Modo de execução: "live" (API real) | "fixture" (dados offline)
WEATHER_MODE=live

# Forecast horizon em horas (máx 384 = 16 dias)
FORECAST_HOURS=48

# ─── Paths ────────────────────────────────────────────────────────────────────
DOMAIN_DIR=domain
FIXTURES_DIR=fixtures
TRACES_DIR=traces

# ─── Logging ──────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
